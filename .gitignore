/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.log
*.meta
.DS_Store
# Except keep .meta files inside Assets
!/[Aa]ssets/**/*.meta

# IDE specific files
.vs/
.vscode/
*.dotsettings

# Scratch: the folder ships with every clone through .gitkeep; everything in it stays local.
# The first line un-ignores the folder itself, which a global ignore rule may exclude.
!/.scratch/
/.scratch/*
!/.scratch/.gitkeep

# Claude Code personal/local settings
.claude/settings.local.json
/.claude/worktrees/

# TMP rewrites the fallback font atlas whenever a new glyph renders; keep that churn local.
/Assets/TextMesh Pro/Resources/Fonts & Materials/LiberationSans SDF - Fallback.asset
__pycache__/

# Agent worktrees
/.worktrees/
